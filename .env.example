# Copy to .env and adjust. docker compose reads it automatically.

# --- Postgres ---
POSTGRES_USER=zapping
POSTGRES_PASSWORD=zapping
POSTGRES_DB=zapping
# Host port mapped to Postgres 5432.
DB_PORT=5432

# --- App ---
# Host port mapped to the app's 8080.
APP_PORT=8080

# false: allow the session cookie over plain HTTP (docker on a non-localhost host).
# true: require HTTPS. Browsers accept Secure cookies on localhost regardless.
COOKIE_SECURE=false

# How often the live window advances one segment. Go duration syntax. Spec asks 10s.
TICK_INTERVAL=10s

# Chat messages kept in memory.
CHAT_HISTORY_SIZE=50

# Host directory with the 64 .ts files and segment.m3u8.
# Mounted read-only into the app at /segments.
SEGMENTS_DIR=./hls test/hls test
