# Copy this file to .env and fill in SEGMENTS_DIR. That is the only line you
# have to touch: everything below already holds the value the app would use on
# its own. docker compose reads .env automatically.

# ---------------------------------------------------------------------------
# Required. The one setting with no default, because it names half a gigabyte
# of media that cannot ship with the code.
# ---------------------------------------------------------------------------

# Unzip the provided archive wherever you like and put that directory here: it
# has to hold segment.m3u8 and the 64 .ts files the playlist names. Mounted
# read-only into the app at /segments. An absolute path is safest, spaces are
# fine, and quotes are not needed — the whole line after = is the value.
SEGMENTS_DIR=/absolute/path/to/hls test

# ---------------------------------------------------------------------------
# Optional from here down. These are the defaults, spelled out.
# ---------------------------------------------------------------------------

# Postgres credentials. The app's DATABASE_URL is assembled from them.
POSTGRES_USER=zapping
POSTGRES_PASSWORD=zapping
POSTGRES_DB=zapping

# Host ports. Change either one if something already listens there — a local
# Postgres on 5432 is the usual collision.
DB_PORT=5432
APP_PORT=8080

# false: allow the session cookie over plain HTTP (docker on a non-localhost host).
# true: require HTTPS. Browsers accept Secure cookies on localhost regardless.
COOKIE_SECURE=false

# Chat messages kept in memory.
CHAT_HISTORY_SIZE=50
